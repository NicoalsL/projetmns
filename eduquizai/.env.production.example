# Modèle des secrets de production (docker-compose.prod.yml).
# Copier en .env.production, remplir, et ne JAMAIS commiter .env.production.
# Procédure complète : docs/deploiement.md.
#
# Générer chaque secret avec :   openssl rand -hex 32
# (hexadécimal : il s'insère dans les URL de connexion sans caractère à échapper)

# Port de la machine hôte sur lequel le site est servi.
PORT_PUBLIC=8080
# Adresse publique du site, sans barre finale (ex. https://eduquizai.exemple.fr).
ORIGINE_FRONT=http://localhost:8080

POSTGRES_MOT_DE_PASSE=
MONGO_UTILISATEUR=eduquizai
MONGO_MOT_DE_PASSE=
# 64 caractères hexadécimaux minimum (vérifié au démarrage de l'API).
JWT_SECRET=

# "simulation" (sans IA), "ollama" (IA locale sur l'hôte) ou "openai".
IA_FOURNISSEUR=simulation
OPENAI_API_KEY=
OPENAI_MODELE=
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODELE=qwen3:8b
