# Image de PRODUCTION du front (docker-compose.prod.yml), en deux étapes :
# 1. construction de l'application avec Node (vite build) ;
# 2. service des fichiers statiques par nginx, sans Node ni code source.
# L'image finale ne contient que le résultat du build (quelques centaines de Ko).

FROM node:22-alpine AS construction
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
# Chaîne vide : le front appelle l'API par des chemins relatifs (/api/...),
# servis par le même nginx (voir nginx.conf). Pas de CORS en production.
ARG VITE_API_URL=""
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

# Variante « unprivileged » de nginx : le serveur ne tourne pas en root
# (même principe que USER node dans l'image du back) et écoute sur 8080.
FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=construction /app/dist /usr/share/nginx/html
EXPOSE 8080
