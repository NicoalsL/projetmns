PORT=3000
ORIGINE_FRONT=http://localhost:5173
# Hôtes internes Docker. Pour lancer le backend hors Docker, adapter ces URL.
# SÉCURITÉ — Moindre privilège : deux comptes PostgreSQL.
# - DATABASE_URL : compte de l'API (eduquizai_app), qui lit et écrit des lignes, rien de plus.
#   « A_GENERER » est remplacé par un mot de passe aléatoire par npm run config:init.
# - DATABASE_URL_ADMIN : compte propriétaire, utilisé seulement par npm run db:init.
DATABASE_URL=postgresql://eduquizai_app:A_GENERER@postgres:5432/eduquizai
DATABASE_URL_ADMIN=postgresql://eduquizai:eduquizai@postgres:5432/eduquizai
# Générer le secret local avec npm run config:init ; ne jamais committer le .env.
JWT_SECRET=
# Génération des quiz : "simulation" (sans IA, gratuit, par défaut), "ollama" (IA locale) ou "openai".
IA_FOURNISSEUR=simulation
# Requise uniquement si IA_FOURNISSEUR=openai. Ne jamais la committer.
OPENAI_API_KEY=
# Facultatif : modèle OpenAI utilisé (gpt-4o-mini par défaut).
OPENAI_MODELE=
# IA locale (IA_FOURNISSEUR=ollama) : Ollama doit tourner sur la machine hôte
# avec le modèle téléchargé (ollama pull qwen3:4b). qwen3:8b : plus fidèle au cours, plus lent.
# HTTP accepté seulement sur la machine locale (localhost, host.docker.internal) ;
# vers une autre machine, HTTPS est exigé au démarrage.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODELE=qwen3:4b
# Durée de maintien du modèle en mémoire après un appel (30m par défaut ; -1 = toujours).
OLLAMA_CONSERVATION=30m
