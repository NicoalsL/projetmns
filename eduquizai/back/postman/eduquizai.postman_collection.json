          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"refus 401\", () => pm.response.to.have.status(401));",
                  "pm.test('message générique (ne révèle pas si l\\'email existe)', () => pm.expect(pm.response.json().erreur).to.eql('Email ou mot de passe incorrect'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Connexion",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
