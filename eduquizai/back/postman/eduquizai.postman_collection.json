                  "pm.test(\"connexion réussie\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('jeton', pm.cookies.get('eduquizai_session'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Inscription d'un second enseignant",
