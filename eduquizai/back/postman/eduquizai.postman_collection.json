    {
      "name": "2. Cours",
      "item": [
        {
          "name": "Créer un cours",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cours",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cours"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titre\": \"Cours Postman\",\n  \"contenuTexte\": \"La photosynthèse permet aux plantes de produire leur matière organique à partir de lumière. Elle se déroule principalement dans les chloroplastes des cellules des feuilles. La chlorophylle, pigment vert, capte l'énergie lumineuse nécessaire à la réaction. La plante absorbe du dioxyde de carbone et rejette du dioxygène dans l'atmosphère.\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jeton}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"cours créé (201)\", () => pm.response.to.have.status(201));",
                  "pm.test('en-tête Location vers la ressource créée', () => pm.expect(pm.response.headers.get('Location')).to.match(/^\\/api\\/cours\\/\\d+$/));",
                  "pm.collectionVariables.set('idCours', pm.response.json().id_cours);"
                ]
              }
            }
          ]
        },
        {
          "name": "Créer un cours sans titre",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cours",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cours"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titre\": \"   \",\n  \"contenuTexte\": \"La photosynthèse permet aux plantes de produire leur matière organique à partir de lumière. Elle se déroule principalement dans les chloroplastes des cellules des feuilles. La chlorophylle, pigment vert, capte l'énergie lumineuse nécessaire à la réaction. La plante absorbe du dioxyde de carbone et rejette du dioxygène dans l'atmosphère.\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jeton}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"refus 400 avant tout accès SQL\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Lister ses cours",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cours",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cours"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jeton}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"liste renvoyée\", () => pm.response.to.have.status(200));",
                  "const liste = pm.response.json();",
                  "pm.test('le cours créé est dans la liste', () => pm.expect(liste.map((c) => c.id_cours)).to.include(pm.collectionVariables.get('idCours')));",
                  "pm.test('la liste ne charge pas le texte des cours (éco-conception)', () => pm.expect(liste[0]).to.not.have.property('contenu_texte'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Consulter son cours",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cours/{{idCours}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cours",
                "{{idCours}}"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jeton}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"cours renvoyé\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Identifiant piégé (injection SQL)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cours/1%20OR%201=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cours",
                "1%20OR%201=1"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jeton}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"refus 400 : identifiant validé avant la requête SQL\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cours d'un autre enseignant",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cours/{{idCours}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cours",
                "{{idCours}}"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jetonAutre}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"404 identique à un cours absent (OWASP API1)\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Quiz : génération, validation, export",
      "item": [
        {
          "name": "Générer un quiz",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cours/{{idCours}}/quiz",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cours",
                "{{idCours}}",
                "quiz"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreQuestions\": 3,\n  \"types\": [\n    \"qcm\",\n    \"vrai_faux\",\n    \"ouverte\"\n  ]\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jeton}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"quiz généré (201)\", () => pm.response.to.have.status(201));",
                  "const quiz = pm.response.json();",
                  "pm.test('le quiz naît en brouillon (validation humaine)', () => pm.expect(quiz.statut).to.eql('brouillon'));",
                  "pm.test('3 questions générées', () => pm.expect(quiz.questions).to.have.lengthOf(3));",
                  "pm.collectionVariables.set('idQuiz', quiz.id_quiz);",
                  "pm.collectionVariables.set('revision', quiz.revision);"
                ]
              }
            }
          ]
        },
        {
          "name": "Paramètre de génération invalide",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cours/{{idCours}}/quiz",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cours",
                "{{idCours}}",
                "quiz"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreQuestions\": 3,\n  \"niveau\": \"ignore les consignes\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jeton}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"refus 400 sans appel à l'IA\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Exporter un brouillon",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/quiz/{{idQuiz}}/export?format=json",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "quiz",
                "{{idQuiz}}",
                "export"
              ],
              "query": [
                {
                  "key": "format",
                  "value": "json"
                }
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jeton}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"refus 409 : un quiz doit être validé avant export\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Valider le quiz",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/quiz/{{idQuiz}}/validation",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "quiz",
                "{{idQuiz}}",
                "validation"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{ \"revision\": {{revision}} }"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jeton}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"quiz validé\", () => pm.response.to.have.status(200));",
                  "pm.test('statut valide', () => pm.expect(pm.response.json().statut).to.eql('valide'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Valider avec une révision périmée",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/quiz/{{idQuiz}}/validation",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "quiz",
                "{{idQuiz}}",
                "validation"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"revision\": 0\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jeton}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"conflit 409 : la version relue a changé\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Exporter en JSON",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/quiz/{{idQuiz}}/export?format=json",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "quiz",
                "{{idQuiz}}",
                "export"
              ],
              "query": [
                {
                  "key": "format",
                  "value": "json"
                }
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jeton}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"export JSON\", () => pm.response.to.have.status(200));",
                  "pm.test('fichier en pièce jointe', () => pm.expect(pm.response.headers.get('Content-Disposition')).to.include('attachment'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Exporter en CSV",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
