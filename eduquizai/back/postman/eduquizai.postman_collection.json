{
  "info": {
    "name": "EduQuizAI — API",
    "description": "Parcours complet d'un enseignant sur l'API EduQuizAI, avec ses contrôles de sécurité. Exécution : Postman (Run collection) ou en ligne de commande avec Newman. Les comptes créés sont supprimés à la fin.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Santé et authentification",
      "item": [
        {
          "name": "Santé de l'API",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sante",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sante"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"le processus répond 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Inscription refusée sans consentement RGPD",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/inscription",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "inscription"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Test Postman\",\n  \"email\": \"sans-consentement@example.test\",\n  \"motDePasse\": \"Postman-2026-ok\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"refus 400 : consentement explicite obligatoire\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Inscription",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/inscription",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "inscription"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Test Postman\",\n  \"email\": \"{{email}}\",\n  \"motDePasse\": \"{{motDePasse}}\",\n  \"consentementRgpd\": true\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"compte créé (201)\", () => pm.response.to.have.status(201));",
                  "const corps = pm.response.json();",
                  "pm.test('un jeton est renvoyé', () => pm.expect(pm.cookies.get('eduquizai_session')).to.be.a('string'));",
                  "pm.test('le mot de passe haché n\\'est jamais renvoyé', () => pm.expect(corps.utilisateur).to.not.have.property('mot_de_passe_hache'));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Email unique à chaque exécution : la collection peut être rejouée.",
                  "pm.collectionVariables.set('email', 'postman-' + Date.now() + '@example.test');",
                  "pm.collectionVariables.set('emailAutre', 'postman-autre-' + Date.now() + '@example.test');"
                ]
              }
            }
          ]
        },
        {
          "name": "Connexion avec un mauvais mot de passe",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/connexion",
              "host": [
